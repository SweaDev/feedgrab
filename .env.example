# LLM provider used for optional detection refinement and text exclusion rules.
# One of: ollama | openai | openrouter | gemini
FD_LLM_PROVIDER=ollama
# Model id for the provider. No default: leave empty to disable LLM features.
FD_LLM_MODEL=
# Optional base URL. Ollama defaults to http://localhost:11434/v1,
# OpenRouter to https://openrouter.ai/api/v1; OpenAI and Gemini use provider defaults.
FD_LLM_BASE_URL=
# API key (not needed for Ollama). Never ship a real key in a distributed extension build.
FD_LLM_API_KEY=
